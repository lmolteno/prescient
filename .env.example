# Copy to .env for local development.
PRESCIENT_DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/prescient
PRESCIENT_API_HOST=0.0.0.0
PRESCIENT_API_PORT=8080
PRESCIENT_LOG_LEVEL=INFO
PRESCIENT_LOG_JSON=false

# Ingest cadence
PRESCIENT_SWPC_POLL_INTERVAL_SECONDS=300
PRESCIENT_HMI_POLL_INTERVAL_SECONDS=60
PRESCIENT_HMI_BACKFILL_DAYS=7
